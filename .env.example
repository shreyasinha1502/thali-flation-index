# Copy to .env (gitignored) and fill in. Never commit real values.

# data.gov.in API key — register free at https://data.gov.in (My Account -> Generate Key).
# The public sample key shown on data.gov.in resource pages is shared by everyone, caps at
# 10 records/call, and is frequently rate-limited (HTTP 429) — use your own key.
DATA_GOV_API_KEY=

# Optional: log level for all pipeline scripts (DEBUG, INFO, WARNING, ERROR).
THALI_LOG_LEVEL=INFO
